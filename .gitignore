# ==============================================================================
# FVelloso SMS — .gitignore
# ==============================================================================

# 1. Environment & Secrets (CRITICAL: Do NOT expose on GitHub)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt

# 2. Dependencies
node_modules/
.pnp
.pnp.js

# 3. Next.js Build Outputs & Caches
.next/
out/
build/
dist/

# 4. TypeScript & Tooling Cache
*.tsbuildinfo
next-env.d.ts

# 5. Testing & Coverage
coverage/
.nyc_output/

# 6. Debug & Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 7. OS & IDE System Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
