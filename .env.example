# ==============================================================================
# FVelloso SMS — Variáveis de Ambiente de Exemplo
# ==============================================================================
# Copie este arquivo para .env e configure as credenciais do seu ambiente.
# NUNCA comite o arquivo .env real no GitHub.

# String de conexão com o banco de dados PostgreSQL (local ou Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fvelloso_sms

# (Opcional) Chave de API da OpenAI para interpretação em linguagem natural no APR
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) SMTP para notificar o responsável pela obra quando uma NC é registrada.
# Sem SMTP_HOST/SMTP_FROM a NC é salva normalmente, mas o e-mail não é enviado.
# Gmail/Workspace: smtp.gmail.com, porta 465, SMTP_PASS = senha de app (não a senha da conta).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=qualidade@empresa.com.br
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="FVelloso SMS <qualidade@empresa.com.br>"
# SMTP_SENDER_NAME=Setor de Qualidade e SST


# Assinatura das sessões de login (mínimo de 32 caracteres aleatórios). Gere com: openssl rand -base64 48
# Sem ela, uma chave derivada do DATABASE_URL é usada. Trocar o valor desconecta todos os usuários.
# SESSION_SECRET=

# Lembretes diários de prazo das NCs (Vercel Cron chama /api/cron/nc-lembretes com este segredo).
# CRON_SECRET=
# E-mail que recebe o aviso de "NC aguardando verificação" (padrão: administrador principal).
# NC_VERIFICACAO_EMAIL=
